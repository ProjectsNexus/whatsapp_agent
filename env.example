# From WhatsApp > Settings > Agents > your agent > Chat info > API key
WHATSAPP_AGENT_TOKEN=

# Your n8n webhook URL (Webhook node, "Respond to Webhook" mode)
# e.g. https://your-n8n-instance.com/webhook/whatsapp-reply
N8N_WEBHOOK_URL=

# Optional: where to persist the polling offset between restarts
OFFSET_FILE=./offset.json
